# Copie este archivo como .env (en la raiz del proyecto) y reemplace CLAVE.
# Deje UNA sola linea DATABASE_URL activa (sin #). El archivo .env NUNCA se sube a GitHub.

# Opcion A: base alojada en la nube (Supabase u otra)
# DATABASE_URL=postgresql://postgres.REF_DEL_PROYECTO:CLAVE@HOST_DEL_POOLER:5432/postgres

# Opcion B: PostgreSQL instalado en el equipo
DATABASE_URL=postgresql://postgres:CLAVE@localhost:5432/solarbi